{
  "name": "@movewise/web",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "predev": "node scripts/copy-engine-assets.mjs && node scripts/setup-db.mjs",
    "dev": "next dev",
    "prebuild": "node scripts/copy-engine-assets.mjs && node scripts/setup-db.mjs",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "next lint",
    "test": "vitest run --passWithNoTests",
    "test:e2e": "playwright test",
    "test:e2e:smoke": "playwright test --grep @smoke",
    "test:e2e:perf": "playwright test --grep @perf",
    "test:perf:smoke": "node scripts/perf-smoke.mjs"
  },
  "dependencies": {
    "@movewise/chess-rules": "workspace:*",
    "@movewise/db": "workspace:*",
    "@movewise/engine": "workspace:*",
    "@movewise/exercise-schema": "workspace:*",
    "bcryptjs": "^3.0.2",
    "next": "^16.3.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "server-only": "^0.0.1",
    "stockfish": "18.0.8"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/eslintrc": "^3.3.6",
    "@playwright/test": "^1.56.1",
    "@types/node": "^26.3.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.2.5",
    "autocannon": "^8.0.0",
    "eslint": "^10.9.1",
    "eslint-config-next": "^16.3.3",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  }
}
