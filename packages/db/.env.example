# Copy to .env. Used by the Prisma CLI (migrate/generate) — the app
# itself reads DATABASE_URL from apps/web/.env.local at runtime, not this
# file (same value in both — see ADR-0005 for the Postgres migration).
#
# For local dev, create a local Postgres role/database once:
#   sudo -u postgres psql -c "CREATE USER movewise WITH PASSWORD 'movewise_dev' CREATEDB;"
#   sudo -u postgres psql -c "CREATE DATABASE movewise_dev OWNER movewise;"
# Or point this at a real Supabase project instead (Project Settings >
# Database > Connection string > "URI", direct connection).
DATABASE_URL="postgresql://movewise:movewise_dev@localhost:5432/movewise_dev"
