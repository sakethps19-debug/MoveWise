generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())

  sessions            Session[]
  completions         LessonCompletion[]
  conceptMasteries    UserConceptMastery[]
  exerciseAttempts    ExerciseAttempt[]
  games               Game[]
  lessonCheckpoints   LessonCheckpoint[]
  passwordResetTokens PasswordResetToken[]
  placementAttempts   PlacementAttempt[]
}

/// Opaque database-backed session tokens (not JWTs) — the cookie holds
/// only a random token, looked up server-side on every request. Simpler
/// to reason about than a signed-token scheme, and trivially revocable.
model Session {
  token     String   @id
  userId    String
  expiresAt DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// Single-use, time-limited password-reset token — same "random token,
/// looked up server-side" shape as Session above, deliberately not a
/// signed/stateless token so a used or expired one simply can't work
/// again no matter what. `usedAt` (rather than deleting the row on use)
/// keeps a record that a reset happened without needing a separate audit
/// table.
model PasswordResetToken {
  token     String    @id
  userId    String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model LessonCompletion {
  id          String   @id @default(cuid())
  userId      String
  lessonId    String
  xpEarned    Int
  /// Wrong attempts across the whole lesson, on the completing run. Raw
  /// fact, not a display value — star tiers are computed from this, not
  /// stored, so the tiering rule can change without a migration.
  mistakes    Int      @default(0)
  /// Hints revealed across the whole lesson, on the completing run — a
  /// zero-mistake run that leaned on hints (up to and including the
  /// solution-reveal level) still isn't a 3-star run. Same "raw fact,
  /// tiering computed elsewhere" reasoning as `mistakes`.
  hintsUsed   Int      @default(0)
  completedAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, lessonId])
}

/// A single in-progress attempt at one lesson — "reopening a lesson
/// restarted at step 1" fix. One row per (user, lesson): resuming
/// overwrites it, finishing the lesson (completeLessonAction) deletes it.
/// `lessonVersion` pins the content version this checkpoint was saved
/// against (Lesson.version, packages/exercise-schema) — a content edit
/// bumps that number, and a stale checkpoint is discarded rather than
/// resumed into a lesson whose step semantics may have changed.
model LessonCheckpoint {
  id            String   @id @default(cuid())
  userId        String
  lessonId      String
  lessonVersion Int
  stepIndex     Int
  /// Which distinct attempt this write belongs to (lib/lessonCheckpointStore.ts's
  /// state machine) — bumped by the client only when starting a genuinely
  /// new attempt (never attempted, "Start over", or revisiting a completed
  /// lesson), never on an ordinary step-advance within one attempt. A write
  /// whose epoch is behind the stored one is always rejected outright,
  /// regardless of its revision — this is what makes an old browser tab's
  /// leftover writes harmless after a restart in another tab, since a
  /// revision number alone can't otherwise distinguish "the same attempt,
  /// just late" from "a completely different, already-superseded attempt".
  epoch         Int      @default(0)
  /// Client-generated, monotonically increasing *within one epoch*
  /// (lib/checkpointClient.ts, incremented once per save/clear/complete
  /// call in components/LessonResumeGate.tsx) — the server rejects any
  /// incoming same-epoch write whose revision isn't strictly greater than
  /// the stored one (apps/web/lib/lessonCheckpointStore.ts), so out-of-order
  /// request arrival (retries, a slow keepalive fetch outliving a faster
  /// later one) can never regress or resurrect a checkpoint within that
  /// attempt, regardless of what order the server actually receives them in.
  revision      Int      @default(0)
  mistakes      Int      @default(0)
  hintsUsed     Int      @default(0)
  /// Same AttemptRecord[] shape LessonCompletion's attempts are derived
  /// from at completion time — stored here mid-lesson so a resumed run's
  /// eventual mastery recompute sees the full history, not just what
  /// happened after resuming.
  attempts      Json
  updatedAt     DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, lessonId])
}

/// ADR-0008's learner model, per (user, concept). `conceptId` is a plain
/// string referencing packages/content/concepts.json's `id` — concepts
/// are authored content, not a database table (see
/// docs/concept-taxonomy.md's correction note), so there's no foreign
/// key here, the same way LessonCompletion.lessonId already references
/// a JSON file's id with no Lesson table backing it.
model UserConceptMastery {
  id        String   @id @default(cuid())
  userId    String
  conceptId String
  /// One of the 9 states in docs/learner-model.md: not-started, learning,
  /// practising, ready-for-assessment, proficient, mastered,
  /// revision-due, struggling, recovered. Stored as a plain string (like
  /// LessonCompletion had no enum before it either) so the state list can
  /// grow without a migration; validity is enforced at the application
  /// layer (apps/web/lib/masteryModel.ts), not the database.
  status               String
  /// Derived from ExerciseAttempt accuracy/hint-usage — see
  /// docs/learner-model.md's "Two evidence sources" section. 0-1 scale.
  exerciseConfidence   Float     @default(0)
  /// Derived from Play & Learn MoveAnalysis (Phase B, not built yet) —
  /// stays 0 until Phase B exists. `mastered` requires both scores, not
  /// exerciseConfidence alone; see docs/learner-model.md.
  gameApplicationScore Float     @default(0)
  lastPracticedAt      DateTime?
  nextRevisionDueAt    DateTime?
  /// P1 "make confirmation evidence meaningful": provenance for *how we
  /// know* about this concept (lib/placementEvidence.ts's
  /// ConceptEvidenceLevel, extended with confirmation_passed) — a
  /// separate axis from `status` above, which tracks *ongoing skill*
  /// from ordinary exercise attempts. A single passed confirmation
  /// quickly upgrades evidenceLevel to confirmation_passed without ever
  /// touching `status` directly; `status` still only ever moves through
  /// computeMasteryStatus's real accuracy-based rules, so "durable
  /// proficiency" (status = proficient/mastered) and "we've directly
  /// checked this once" (evidenceLevel = confirmation_passed) can never
  /// be conflated with each other.
  evidenceLevel        String?
  /// 0-1, independent of exerciseConfidence — how sure *this evidence
  /// source* (placement inference, a confirmation attempt) is, decayed
  /// on a later contradiction rather than reset to 0 (still worth
  /// something, just no longer fully trusted).
  evidenceConfidence   Float?
  /// Free-text provenance, e.g. "placement:v1" or "confirmation:2026-08-30" —
  /// which attempt/source last set evidenceLevel, for the "explain the
  /// result to the learner" and audit requirements.
  evidenceSource       String?
  evidenceUpdatedAt    DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, conceptId])
  @@index([userId])
}

/// One row per exercise attempt (not just per lesson completion) — the
/// per-attempt detail LessonCompletion's mistakes/hintsUsed counts are
/// aggregated from and then thrown away today. See docs/learner-model.md
/// — this is the concrete first implementation step that document
/// flagged as the raw material already existing (LessonRunner's
/// handleIncorrect(key) already receives everything here, it just wasn't
/// persisted).
model ExerciseAttempt {
  id             String   @id @default(cuid())
  userId         String
  /// Exactly one of lessonId/puzzleId/gameId is set — which content type
  /// this attempt was against. Kept as separate nullable columns (rather
  /// than a single polymorphic `refId`) so each keeps its own clearly-
  /// named index and existing lessonId-keyed queries need no change. See
  /// ADR-0008's Puzzle type — puzzles are pooled, concept-tagged
  /// exercises outside any lesson. gameId marks a mistake detected in a
  /// real analysed game (lib/conceptDetection.ts) rather than authored
  /// content — the only source that is always `correct: false` (a
  /// detected mistake is itself the negative evidence).
  lessonId       String?
  puzzleId       String?
  gameId         String?
  stepId         String
  /// The lesson's masteryTags (or the puzzle's conceptIds) at attempt
  /// time — which concepts this attempt is evidence for. Denormalized
  /// onto the attempt (not looked up later) so historical attempts stay
  /// meaningful even if a lesson/puzzle's tags are recurated later.
  conceptIds     String[]
  correct        Boolean
  /// The feedback-map key that was hit on a wrong answer (e.g.
  /// "knight-jumps-over") — null for a correct attempt. Raw material for
  /// RecurringMistakePattern (docs/learner-model.md), not built this pass.
  wrongAnswerKey String?
  hintLevelUsed  Int      @default(0)
  createdAt      DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, lessonId])
  @@index([userId, puzzleId])
  @@index([userId, gameId])
  @@index([userId, createdAt])
}

/// ADR-0008 Phase B: a completed Play & Learn game, persisted so it can be
/// analyzed after the fact — Play mode was previously stateless once the
/// page unmounted. `source` is a string, not an enum, so a later source
/// (PGN import, a human-vs-human mode) is additive; only "stockfish" is
/// reachable today (Play mode's only opponent).
model Game {
  id     String @id @default(cuid())
  userId String

  /// "stockfish" is the only value produced by this codebase today.
  /// "training-bot" | "pgn-import" | "otb-manual" | "platform-import" are
  /// reserved, per ADR-0008, for sources that don't exist yet.
  source      String
  pgn         String
  /// The learner's own color for this game — needed to interpret `result`
  /// and to orient move-by-move analysis from the learner's perspective.
  playerColor String
  /// From the learner's own perspective: "win" | "loss" | "draw" | "resigned".
  result      String
  /// The specific way the game ended — chess-rules' own GameStatus values,
  /// plus "resigned" (which isn't a GameStatus, since it's not a board
  /// state). Kept separate from `result` so "how" and "who won" don't have
  /// to be re-derived from one overloaded string later.
  endReason   String
  playedAt    DateTime @default(now())

  /// Fair-play invariant (ADR-0008, "Decision — fair play"): whether this
  /// game is even eligible for post-game analysis at all. True for every
  /// source reachable today (Stockfish games are always analyzable) — the
  /// field exists now, before any human-vs-human mode is even scaffolded,
  /// so a future PvP source can default it false rather than the check
  /// being bolted on after the fact. See lib/gameAnalysis.ts's canAnalyze.
  analysisAllowed Boolean @default(true)

  user     User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  analysis GameAnalysis?

  @@index([userId])
}

/// One row per analyzed `Game`. `status` is always "complete" today — this
/// codebase has no background-job infrastructure (no queue, no worker
/// process), so analysis runs client-side against the same Stockfish Web
/// Worker Play mode already uses (packages/engine), synchronously from the
/// caller's perspective, and is persisted only once finished. "pending" /
/// "running" / "failed" are reserved for a real async pipeline, not
/// reachable yet — see docs/roadmap.md's Phase B entry for the honest
/// scope cut this represents versus ADR-0008's originally-specified
/// server-side async pipeline.
model GameAnalysis {
  id        String   @id @default(cuid())
  gameId    String   @unique
  status    String
  /// Classification counts (lib/gameAnalysis.ts's `summarize`) — cheap,
  /// genuinely useful today; ADR-0008's fuller "opening/middlegame/endgame
  /// assessment, strong-move %, recurring patterns" summary is aspirational,
  /// not built this pass.
  summary   Json
  createdAt DateTime @default(now())

  game  Game           @relation(fields: [gameId], references: [id], onDelete: Cascade)
  moves MoveAnalysis[]
}

/// One row per ply. `conceptIds` mirrors ExerciseAttempt's own
/// denormalized-string-array convention (docs/concept-taxonomy.md's join
/// point) — populated only when one of lib/conceptDetection.ts's
/// detectors actually recognizes the mistake, empty for most moves.
model MoveAnalysis {
  id             String @id @default(cuid())
  gameAnalysisId String
  ply            Int
  moveNumber     Int
  color          String
  playedMove     String
  bestMove       String
  evalBefore     Float
  evalAfter      Float
  evalLoss       Float
  classification String
  conceptIds     String[]
  explanation    String?

  gameAnalysis GameAnalysis @relation(fields: [gameAnalysisId], references: [id], onDelete: Cascade)

  @@index([gameAnalysisId])
}

/// P1 "honest placement evidence": one row per completed placement
/// assessment attempt (lib/placement.ts's scorePlacement), never
/// overwritten in place — a learner who retakes the assessment gets a
/// new row, so what was tested and when is never lost. `conceptEvidence`
/// is the full per-concept evidence-level breakdown
/// (lib/placementEvidence.ts's ConceptEvidence[]), replacing an earlier,
/// coarser "2 of 4 foundational items correct grants the whole cluster"
/// model that collapsed every concept to a single flat "demonstrated or
/// not" — untested king/pawn-movement knowledge, for example, is now
/// explicitly labeled `inferred_high_confidence` rather than silently
/// merged with a concept the learner actually answered a question about
/// (`directly_demonstrated`).
model PlacementAttempt {
  id                String    @id @default(cuid())
  userId            String
  assessmentVersion Int
  startedAt         DateTime
  completedAt       DateTime  @default(now())
  /// Each answered item in order — lib/placement.ts's PlacementAnswer[] ({itemId, correct}).
  itemResponses     Json
  /// Per-concept evidence-level breakdown at the time of this attempt — lib/placementEvidence.ts's ConceptEvidence[].
  conceptEvidence   Json
  confidence        Float
  tierResult        String
  /// Non-null only when the assessment ended before every item was asked — lib/placement.ts's early-exit rule.
  earlyExitReason   String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// Backs apps/web/lib/rate-limit.ts's sliding-window limiter. One row per
/// attempt (login/signup), not per key — a key's current count is
/// `COUNT(*) WHERE key = ? AND createdAt > now() - window`. Exists
/// specifically because in-memory, per-process state doesn't work on a
/// serverless deploy target (see docs/deployment.md, docs/known-risks.md)
/// — every invocation there is a fresh process with fresh memory, so an
/// in-memory limiter is close to a no-op in production as actually
/// deployed.
model RateLimitHit {
  id        String   @id @default(cuid())
  key       String
  createdAt DateTime @default(now())

  @@index([key, createdAt])
}
